// Stroke forms: none, with and without cap/join (in either combination), a
// gradient as the stroke color, and a computed width.
page { size: A4 }

rect none_stroke { stroke: none }
rect plain { stroke: { color: #000000, width: 2pt } }
rect cap_only { stroke: { color: #FF0000, width: 1, cap: round } }
rect join_only { stroke: { color: #FF0000, width: 1, join: bevel } }
rect cap_and_join { stroke: { color: #FF0000, width: 1pt, cap: square, join: miter } }
rect gradient_color { stroke: { color: linear_gradient(0, #000000, #FFFFFF), width: 3pt } }
rect computed_width { stroke: { color: rgb(0, 0, 0), width: 1pt + 1pt } }
